APP_NAME="POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL is the only supported database. The installer fills these in at Step 4
# (Database). Leave them blank in the shipped template.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=root
DB_PASSWORD=

# File-based session + cache so the app needs NO database to boot — the
# installer runs (and renders its CSRF-protected forms) before any database
# exists. Shared-hosting friendly: no Redis, no extra DB round-trip per request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# Queue runs on the database driver, drained by cron (no daemons).
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail logs by default; the customer configures real SMTP in Settings.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# License — written by the installer at Step 3.
# Set POS_LICENSE_REQUIRED=false to skip license activation entirely (installer
# license step + background re-check). Leave it out (or true) to enforce.
# POS_LICENSE_REQUIRED=true
LICENSE_KEY=
LICENSE_FINGERPRINT=
# SaaS builds only: per-instance secret minted by the license server at
# provisioning, signs every phone-home request. Leave blank for a legacy
# (non-SaaS) one-time-validate build — the check is skipped, not sent unsigned.
LICENSE_HMAC_SECRET=

# Demo mode — flip ON for the public demo install. When true, the login page
# shows a small notice with a link to POS_DEMO_WEBSITE_URL so visitors who land
# on the demo can find their way back to the product website. Leave OFF for
# real customer installs.
# POS_DEMO_MODE=true
# POS_DEMO_WEBSITE_URL=https://tillora.sphereofthesun.com
# Pre-fillable demo credentials shown on the login page. Each pair adds a
# "Copy & Fill" card. Leave a pair blank to hide that role's card.
# POS_DEMO_ADMIN_EMAIL=admin@demo.test
# POS_DEMO_ADMIN_PASSWORD=12345678
# POS_DEMO_CASHIER_EMAIL=cashier@demo.test
# POS_DEMO_CASHIER_PASSWORD=12345678

VITE_APP_NAME="${APP_NAME}"
